---
const tiers = [
  {
    name: "오픈소스",
    badge: "FREE",
    price: "0",
    unit: "원",
    suffix: "/ 영구",
    detail: "개인 저장소와 공개 프로젝트를 위한 기본 작업실.",
    features: [
      "유스케이스 무제한",
      "로컬 SQLite + Postgres",
      "CLI vspec 전체 명령",
      "GitHub 단방향 동기화",
    ],
    cta: "바로 시작",
    href: "https://github.com/vibemafiaclub/vooster",
    variant: "outline",
  },
  {
    name: "팀",
    badge: "POPULAR",
    price: "49,000",
    unit: "원",
    suffix: "/ 월·시트",
    detail: "공유 세션, 게이트 리포트, 권한 관리가 켜진 협업 작업실.",
    features: [
      "오픈소스 전부 포함",
      "공유 세션 + 멀티-에이전트 락",
      "게이트 리포트 자동 게시",
      "팀 권한 + 감사 로그",
    ],
    cta: "도입 상담",
    href: "mailto:hello@vooster.local",
    variant: "primary",
    emphasized: true,
  },
  {
    name: "조직",
    badge: "ENTERPRISE",
    price: "맞춤",
    unit: "",
    suffix: "/ 연 계약",
    detail: "사내 워크플로, 감사 로그, 배포 환경 분리, SSO 지원.",
    features: [
      "팀 전부 포함",
      "SAML / SSO",
      "사내 호스팅 + VPC 격리",
      "전용 솔루션 엔지니어",
    ],
    cta: "문의하기",
    href: "mailto:enterprise@vooster.local",
    variant: "outline",
  },
];
---

<section id="pricing" class="pricing" aria-labelledby="pricing-title">
  <div class="section-shell">
    <div class="pricing__head">
      <p class="eyebrow-mono">PRICING</p>
      <h2 id="pricing-title" class="section-heading">
        작게 시작해서 팀 흐름에 맞춰<br />
        <em>넓혀갑니다</em>.
      </h2>
      <p class="section-copy">
        오픈소스는 영구 무료. 시트 단위 과금만, 사용량 함정 없음.
        14일 이내 환불, 사전 약정 없음.
      </p>
    </div>

    <div class="pricing__grid">
      {tiers.map((tier) => (
        <article
          class={`tier${tier.emphasized ? " tier--emphasized" : ""}`}
          aria-label={`${tier.name} 요금제`}
        >
          <header class="tier__head">
            <h3 class="tier__name">{tier.name}</h3>
            <span class={`tier__badge${tier.emphasized ? " tier__badge--accent" : ""}`}>
              {tier.badge}
            </span>
          </header>

          <div class="tier__price">
            <span class="tier__price-num mono-num">{tier.price}</span>
            {tier.unit && <span class="tier__price-unit">{tier.unit}</span>}
            <span class="tier__price-suffix">{tier.suffix}</span>
          </div>

          <p class="tier__detail">{tier.detail}</p>

          <ul class="tier__features">
            {tier.features.map((feature) => (
              <li>
                <svg
                  class="tier__check"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  aria-hidden="true"
                >
                  <path d="M3 8.5l3 3 7-7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <a
            class={`btn ${tier.variant === "primary" ? "btn--primary" : "btn--outline"} tier__cta`}
            href={tier.href}
          >
            {tier.cta}
            <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pricing {
    padding: var(--space-7xl) 0;
    background: var(--color-canvas);
    border-bottom: var(--hairline);
  }

  .pricing__head {
    margin-bottom: var(--space-5xl);
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
    align-items: stretch;
  }

  .tier {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding: var(--space-3xl) var(--space-2xl);
    border: var(--hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    transition:
      border-color 200ms ease-out,
      transform 200ms ease-out;
  }

  .tier:hover {
    border-color: var(--color-primary-deep);
    transform: translateY(-2px);
  }

  .tier--emphasized {
    background: var(--color-canvas-raised);
    border-color: var(--color-primary-deep);
    box-shadow: 0 24px 60px -32px rgba(45, 212, 191, 0.25);
    position: relative;
  }

  .tier--emphasized::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: var(--radius-md);
    padding: 1px;
    background: linear-gradient(180deg, rgba(45, 212, 191, 0.6), rgba(45, 212, 191, 0));
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .tier__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .tier__name {
    margin: 0;
    color: var(--color-ink-strong);
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .tier__badge {
    padding: 4px 8px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xs);
    background: var(--color-canvas-soft);
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .tier__badge--accent {
    border-color: var(--color-primary-deep);
    color: var(--color-primary-soft);
    background: color-mix(in oklab, var(--color-primary) 14%, transparent);
  }

  .tier__price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    color: var(--color-ink-strong);
  }

  .tier__price-num {
    font-size: 2.4rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .tier__price-unit {
    font-size: 1.1rem;
    color: var(--color-body);
  }

  .tier__price-suffix {
    margin-left: 6px;
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .tier__detail {
    margin: 0;
    color: var(--color-body);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .tier__features {
    margin: 0;
    padding: var(--space-md) 0 0;
    border-top: var(--hairline);
    list-style: none;
    display: grid;
    gap: var(--space-sm);
  }

  .tier__features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--color-ink);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .tier__check {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    margin-top: 3px;
    color: var(--color-primary);
  }

  .tier__cta {
    margin-top: auto;
    align-self: stretch;
  }

  @media (max-width: 880px) {
    .pricing__grid {
      grid-template-columns: 1fr;
    }

    .tier--emphasized {
      order: -1;
    }
  }
</style>
