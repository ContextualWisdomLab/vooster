#!/usr/bin/env bash
# pre-commit hook — fast staged-impact regression check.
#
# Why this exists:
#   Small TDD commits need commit-time feedback in seconds. The full
#   regression sweep still runs in CI and via pre-push/manual verify;
#   this hook checks only the files staged for this commit plus hygiene
#   blockers that should never enter public history.
#
# Install:
#   cd <repo root>
#   ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit
#
# Bypass (rare, knowingly broken intermediate state):
#   git commit --no-verify
#
# Cost target: P50 <2s, P95 <5s for ordinary source/doc commits.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if bash scripts/commit-check.sh; then
  exit 0
fi

cat <<'EOF'

✗ commit blocked: staged impact check failed.

  Either:
    - Fix the staged issue(s) and re-commit, or
    - git commit --no-verify   # only if you know you need a broken
                               # intermediate state on the branch
EOF
exit 1
