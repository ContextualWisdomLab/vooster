---
const faqs = [
  {
    q: "어떤 coding agent와 호환되나요?",
    a: "CLI 도구라 Claude Code, Cursor, Codex, Aider 등 모든 coding agent와 호환됩니다. `npx vspec ai-guide` 한 줄로 agent가 vspec 사용법을 셀프 학습합니다.",
  },
  {
    q: "내 spec과 코드가 vooster 서버에 올라가나요?",
    a: "spec 원본은 항상 당신의 저장소 안의 `specs/*.md` 파일입니다. 클라우드는 동기화·검증용이고, 회사 코드라 부담된다면 `docker compose` 로 self-host 할 수 있습니다.",
  },
  {
    q: "무료인가요?",
    a: "지금은 모든 기능이 무료입니다. 향후 paid tier를 검토 중이지만, self-host는 계속 무료로 유지합니다.",
  },
  {
    q: "spec 쓰는 시간이 오히려 더 걸리지 않나요?",
    a: "아닙니다. agent가 당신의 자연어 요청을 받아 spec으로 자동 구조화합니다. 당신은 평소처럼 채팅으로 “로그인 만들어줘” 하면 끝.",
  },
];

function renderInline(text: string): string {
  return text.replace(/`([^`]+)`/g, '<code class="code-chip">$1</code>');
}
---

<section id="faq" class="section bg-canvas">
  <div class="shell">
   <div class="max-w-[840px]">
    <p class="eyebrow">FAQ</p>
    <h2 class="section-heading">
      시작 전에 자주<br />
      <em>묻는 것들</em>.
    </h2>

    <dl class="mt-14 flex flex-col gap-10">
      {faqs.map((item) => (
        <div class="border-t border-hairline pt-8">
          <dt class="text-ink-strong text-xl md:text-2xl font-semibold tracking-tight leading-snug">
            {item.q}
          </dt>
          <dd class="mt-4 m-0 text-body text-base leading-[1.7]" set:html={renderInline(item.a)} />
        </div>
      ))}
    </dl>
   </div>
  </div>
</section>
