{
  "name": "vooster",
  "version": "1.0.0",
  "description": "Cockburn-style use case management for environments with **6+ concurrent AI coding agents**.",
  "private": true,
  "packageManager": "pnpm@11.0.5",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "predev": "if [ -n \"${DATABASE_URL:-}\" ]; then prisma db push --schema apps/api/prisma/schema.prisma --skip-generate; fi",
    "dev": "tsx watch apps/api/src/index.ts",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "postinstall": "prisma generate --schema apps/api/prisma/schema.prisma",
    "prepare": "git config core.hooksPath scripts/hooks 2>/dev/null || true",
    "prestart": "if [ -n \"${DATABASE_URL:-}\" ]; then prisma db push --schema apps/api/prisma/schema.prisma --skip-generate; fi",
    "start": "node dist/apps/api/src/index.js",
    "test": "node scripts/run-vitest.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "bash scripts/completion-check.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibemafiaclub/vooster.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/vibemafiaclub/vooster/issues"
  },
  "homepage": "https://github.com/vibemafiaclub/vooster#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@oclif/core": "^4.14.0",
    "@prisma/client": "^5.22.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "@vooster/contracts": "workspace:*",
    "argon2": "^0.44.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "eslint": "10.4.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "fastify": "^5.12.5",
    "marked": "^18.0.14",
    "pino": "^10.3.1",
    "prettier": "3.8.3",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  }
}
