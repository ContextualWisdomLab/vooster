#!/usr/bin/env bash
# pre-push hook — full regression boundary before sharing a branch.
#
# Install:
#   Automatic — `pnpm install` runs the root `prepare` script, which sets
#   `git config core.hooksPath scripts/hooks` (wires both hooks). Run that
#   command yourself if you installed with scripts disabled.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if bash scripts/completion-check.sh; then
  exit 0
fi

cat <<'EOF'

✗ push blocked: completion-check failed.

  Fix the failing goal(s), or push with --no-verify only when you knowingly
  need to share a broken intermediate branch.
EOF
exit 1
