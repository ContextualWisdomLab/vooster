# Copy to .env. Values shown are local dogfood defaults.

# --- Database ---
DATABASE_URL=postgresql://vspec:vspec@localhost:5434/vspec
# Tests append a unique schema parameter to this base URL.
TEST_DATABASE_URL=postgresql://vspec:vspec@localhost:5433/vspec_test

# --- HTTP server ---
# The API listens on this port. Defaults to 8080.
PORT=8080

# --- Auth (production) ---
# Required in non-stub mode. Get from https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Auth (dev / test / dogfood) ---
# Set to 1 to enable stubbed OAuth (rejects when NODE_ENV=production).
VSPEC_AUTH_STUB=1
