---
// 호환 가능한 코딩 에이전트 라인 — 산개(scatter) 레이아웃 + 스크롤 converge 인터랙션.
// 각 항목은 "휴식 위치(top/left %)" + "출발 방향(--dx, --dy)" + "회전(--rot)"을 갖는다.
// (--dx, --dy)는 rest 위치에서 바깥쪽 방향. 카드는 그 방향의 먼 지점에서 출발해 rest로 모여든다.
// `logo`는 /public/logos/ 아래의 공식 마크. `mono: true` 인 마크는 currentColor 기반이라
// CSS에서 색을 입혀준다 (검정 fill 을 흰색으로 뒤집어주는 역할).
const agents = [
  {
    name: "Claude Code",
    note: "Anthropic",
    logo: "/logos/claude.svg",
    pos: { top: "14%", left: "10%" },
    dir: { x: -0.95, y: -0.9 },
    rot: -5,
    size: "lg",
  },
  {
    name: "Cursor",
    note: "AI Editor",
    logo: "/logos/cursor.svg",
    pos: { top: "6%", left: "80%" },
    dir: { x: 1.0, y: -1.1 },
    rot: 4,
    size: "md",
  },
  {
    name: "Codex CLI",
    note: "OpenAI",
    logo: "/logos/openai.svg",
    mono: true,
    pos: { top: "48%", left: "3%" },
    dir: { x: -1.25, y: 0.0 },
    rot: -3,
    size: "md",
  },
  {
    name: "Aider",
    note: "Pair-program",
    logo: "/logos/aider.svg",
    pos: { top: "44%", left: "94%" },
    dir: { x: 1.3, y: 0.05 },
    rot: 5,
    size: "lg",
  },
  {
    name: "Cline",
    note: "VS Code",
    logo: "/logos/cline.png",
    pos: { top: "84%", left: "20%" },
    dir: { x: -0.7, y: 1.2 },
    rot: -4,
    size: "md",
  },
  {
    name: "Continue",
    note: "Open-source",
    logo: "/logos/continue.png",
    pos: { top: "82%", left: "78%" },
    dir: { x: 0.75, y: 1.05 },
    rot: 3,
    size: "lg",
  },
] as const;
---

<section
  id="compatible"
  class="section-tight bg-canvas border-b border-hairline"
  aria-labelledby="compatible-title"
>
  <div class="shell">
    <div class="text-center">
      <p class="eyebrow justify-center">COMPATIBLE WITH</p>
      <p id="compatible-title" class="text-body text-[15px] md:text-base leading-[1.7] m-0">
        당신이 이미 쓰는 <em class="not-italic text-ink-strong font-medium">코딩 에이전트</em>와 그대로 연결됩니다.
      </p>
    </div>

    <div
      class="logo-cloud mt-12 md:mt-16 mx-auto"
      data-logo-cloud
      role="list"
      aria-label="호환되는 코딩 에이전트 목록"
    >
      <!-- Center: vooster anchor -->
      <div class="logo-cloud-center" aria-hidden="true">
        <div class="logo-cloud-anchor">
          <span class="logo-cloud-anchor-icon">
            <svg
              viewBox="0 0 160 160"
              width="26"
              height="26"
              class="logo-cloud-anchor-mark"
              fill="none"
              aria-hidden="true"
            >
              <circle cx="80" cy="80" r="72.7273" stroke="currentColor" stroke-width="14.5455" />
              <path
                d="M88.8889 44.4434L53.3333 79.9989H106.667L71.1111 115.554"
                stroke="currentColor"
                stroke-width="17.7778"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <div class="logo-cloud-anchor-text">
            <div class="logo-cloud-anchor-name">vooster</div>
            <div class="logo-cloud-anchor-tag">SPEC HUB</div>
          </div>
        </div>
      </div>

      {agents.map((agent) => (
        <div
          class={`logo-cloud-item logo-cloud-size-${agent.size}`}
          role="listitem"
          style={`top: ${agent.pos.top}; left: ${agent.pos.left}; --dx: ${agent.dir.x}; --dy: ${agent.dir.y}; --rot: ${agent.rot}deg;`}
        >
          <div class="logo-cloud-card">
            <span class={`logo-cloud-card-icon${"mono" in agent && agent.mono ? " logo-cloud-card-icon-mono" : ""}`}>
              <img src={agent.logo} alt="" loading="lazy" decoding="async" width="28" height="28" />
            </span>
            <span class="logo-cloud-card-text">
              <span class="logo-cloud-card-name">{agent.name}</span>
              <span class="logo-cloud-card-note">{agent.note}</span>
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .eyebrow.justify-center::before {
    display: none;
  }

  /* ── 컨테이너 ─────────────────────────────────────────────────── */
  .logo-cloud {
    position: relative;
    width: 100%;
    max-width: 1080px;
    height: clamp(420px, 50vw, 560px);
    /* JS가 갱신하는 두 변수: 스크롤에 따른 외곽 → rest converge, fade-in */
    /* 초기값은 "아직 안 모인" 상태로 두어 첫 paint 부터 외곽 출발점을 잡는다. */
    --spread: 140px;
    --fade: 0.35;
  }

  /* ── 중앙 vooster 앵커 ────────────────────────────────────────── */
  .logo-cloud-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .logo-cloud-anchor {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 18px 22px;
    border-radius: 14px;
    border: 1px solid var(--color-primary-deep);
    background: var(--color-canvas-raised);
    box-shadow:
      0 0 0 4px rgba(45, 212, 191, 0.08),
      0 24px 60px -28px rgba(45, 212, 191, 0.32);
  }

  .logo-cloud-anchor-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--color-canvas);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    color: var(--color-primary);
  }

  .logo-cloud-anchor-mark {
    width: 26px;
    height: 26px;
    color: inherit;
    filter: drop-shadow(0 0 6px rgba(45, 212, 191, 0.45));
  }

  .logo-cloud-anchor-text {
    text-align: center;
  }

  .logo-cloud-anchor-name {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink-strong);
    letter-spacing: -0.01em;
  }

  .logo-cloud-anchor-tag {
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    color: var(--color-mute);
    letter-spacing: 0.18em;
  }

  /* ── 떠다니는 agent 카드 ─────────────────────────────────────── */
  .logo-cloud-item {
    position: absolute;
    z-index: 1;
    will-change: transform, opacity;
    transform:
      translate(-50%, -50%)
      translate(
        calc(var(--dx) * var(--spread)),
        calc(var(--dy) * var(--spread))
      )
      rotate(var(--rot));
    opacity: var(--fade);
  }

  .logo-cloud-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 10px 10px;
    border-radius: 12px;
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas-soft);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.02) inset,
      0 18px 38px -28px rgba(0, 0, 0, 0.6);
    white-space: nowrap;
  }

  .logo-cloud-size-lg .logo-cloud-card {
    padding: 11px 16px 11px 11px;
    gap: 11px;
  }
  .logo-cloud-size-md .logo-cloud-card {
    padding: 9px 13px 9px 9px;
    gap: 9px;
  }

  .logo-cloud-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--color-canvas);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    flex-shrink: 0;
    overflow: hidden;
  }

  .logo-cloud-card-icon img {
    width: 22px;
    height: 22px;
    object-fit: contain;
    display: block;
  }

  /* 검은색 단색 마크(OpenAI) 는 다크 캔버스에서 보이도록 반전 */
  .logo-cloud-card-icon-mono img {
    filter: invert(1);
  }

  .logo-cloud-size-lg .logo-cloud-card-icon {
    width: 34px;
    height: 34px;
  }
  .logo-cloud-size-lg .logo-cloud-card-icon img {
    width: 24px;
    height: 24px;
  }
  .logo-cloud-size-md .logo-cloud-card-icon {
    width: 30px;
    height: 30px;
  }
  .logo-cloud-size-md .logo-cloud-card-icon img {
    width: 20px;
    height: 20px;
  }

  .logo-cloud-card-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .logo-cloud-card-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink-strong);
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .logo-cloud-card-note {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-mute);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    line-height: 1.3;
  }

  /* ── 좁은 화면 폴백 ─────────────────────────────────────────────
   * 640px 미만에서는 scatter를 포기하고 grid로. spread/fade는 비활성화.
   */
  @media (max-width: 640px) {
    .logo-cloud {
      height: auto;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .logo-cloud-center {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      grid-column: 1 / -1;
      justify-self: center;
      margin-bottom: 4px;
    }

    .logo-cloud-item {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      transform: none !important;
      opacity: 1 !important;
    }

    .logo-cloud-card {
      white-space: normal;
      padding: 10px 12px !important;
    }
  }

  /* ── 모션 감소 ─────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .logo-cloud-item {
      transform: translate(-50%, -50%) rotate(var(--rot));
      opacity: 1 !important;
    }
  }
</style>

<script is:inline>
  /**
   * Compatible 섹션 converge 인터랙션.
   * 스크롤 진행도 0..1에 따라 카드들이 외곽에서 rest 위치로 모여들고 fade in.
   * 좁은 화면(< 640px)에서는 CSS가 transform/opacity를 무력화하므로 JS는 그대로 돌려도 무해하다.
   */
  (function () {
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var cloud = document.querySelector('[data-logo-cloud]');
    if (!cloud) return;
    var section = cloud.closest('section');
    if (!section) return;

    var ticking = false;
    function update() {
      var rect = section.getBoundingClientRect();
      var vh = window.innerHeight || 1;

      /**
       * 섹션이 "등장하는 동안" 카드는 모이고, "정독 위치"부터는 정지.
       * triggerStart: section 상단이 viewport 하단부(90%) 근처 — 막 등장. progress=0, 최대 spread.
       * triggerEnd: section 상단이 viewport 상단부(15%) 근처 — 정독 위치. progress=1, spread=0.
       */
      var triggerStart = vh * 0.9;
      var triggerEnd = vh * 0.15;
      var raw = (triggerStart - rect.top) / (triggerStart - triggerEnd);
      var progress = Math.max(0, Math.min(1, raw));

      // 출발 외곽 거리: 화면 폭에 비례, 80~180px로 클램프.
      var maxSpread = Math.max(80, Math.min(180, window.innerWidth * 0.11));
      cloud.style.setProperty('--spread', ((1 - progress) * maxSpread) + 'px');
      cloud.style.setProperty('--fade', String(0.35 + progress * 0.65));
      ticking = false;
    }

    window.addEventListener('scroll', function () {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>
