---
import { ONBOARDING_PROMPT } from "../../lib/copy";

const steps = [
  {
    n: "01",
    actor: "USER",
    title: "coding agent에 vooster 연결 (프롬프트 붙여넣기)",
    kind: "copy" as const,
  },
  {
    n: "02",
    actor: "USER",
    title: "평소처럼 자연어로 요청",
    kind: "chat" as const,
    body: '"로그인 기능 만들어줘"',
    speaker: "Claude Code",
  },
  {
    n: "03",
    actor: "AGENT",
    title: "agent가 spec 구조화 + Lock",
    kind: "chat" as const,
    body: '"UC-013으로 정리했습니다. 이대로 구현할까요?"',
    speaker: "agent",
  },
  {
    n: "04",
    actor: "VOOSTER",
    title: "코드/테스트 링크 검증",
    kind: "result" as const,
  },
];
---

<section id="get-started" class="section section-soft">
  <div class="shell">
    <div class="max-w-[760px]">
      <p class="eyebrow">GET STARTED</p>
      <h2 class="section-heading">
        내 에이전트가<br />
        <em>Spec 전문가가 됩니다.</em>
      </h2>
      <p class="mt-6 max-w-[640px] text-body text-base md:text-lg leading-[1.7]">
        PM에게 <em class="not-italic text-ink-strong font-medium">Jira</em>를,
        개발자에게 <em class="not-italic text-ink-strong font-medium">Git</em>을 주는 것과 마찬가지입니다.<br />
        같은 에이전트라도 <em class="not-italic text-primary-soft font-medium">Vooster와 함께라면</em>
        훨씬 구체적인 기획을 할 수 있게 됩니다.
      </p>
    </div>

    <ol class="mt-16 grid gap-5 md:grid-cols-2 list-none p-0 onboarding-grid">
      {steps.map((step) => (
        <li class="card flex flex-col gap-4 p-7 transition-colors duration-200 hover:border-primary-deep">
          <header class="flex items-baseline justify-between gap-2">
            <div class="flex items-baseline gap-3">
              <span class="mono-num text-primary-soft text-2xl">{step.n}</span>
              <span class="text-mute font-mono text-[11px] font-semibold uppercase tracking-[0.14em]">
                {step.actor}
              </span>
            </div>
            <span aria-hidden="true" class="text-mute/60 font-mono text-[11px]">{step.n}/04</span>
          </header>

          <h3 class="text-ink-strong text-lg font-semibold tracking-tight leading-snug m-0">
            {step.title}
          </h3>

          {step.kind === "copy" && (
            <div class="flex flex-col gap-3 mt-1" data-onboarding-copy>
              <div class="relative">
                <pre class="m-0 p-4 pr-12 bg-canvas-raised border border-hairline rounded-sm text-ink text-[13px] leading-relaxed font-mono whitespace-pre-wrap break-words" data-onboarding-prompt>{ONBOARDING_PROMPT}</pre>
                <button
                  type="button"
                  class="absolute top-2 right-2 inline-flex items-center justify-center w-9 h-9 rounded-sm border border-hairline bg-canvas text-mute hover:text-primary-soft hover:border-primary-deep transition-colors"
                  aria-label="프롬프트 복사"
                  data-onboarding-copy-btn
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <rect x="9" y="9" width="11" height="11" rx="2" />
                    <path d="M5 15V5a2 2 0 012-2h10" />
                  </svg>
                </button>
              </div>
            </div>
          )}

          {step.kind === "chat" && (
            <div class="mt-1 p-4 bg-canvas-raised border border-hairline rounded-sm">
              <div class="text-mute font-mono text-[11px] uppercase tracking-[0.14em] mb-2">
                💬 {step.speaker}
              </div>
              <p class="m-0 text-ink-strong text-[15px] leading-snug">{step.body}</p>
            </div>
          )}

          {step.kind === "result" && (
            <div class="mt-1 p-4 bg-canvas-raised border border-success/40 rounded-sm font-mono text-[12px] leading-relaxed">
              <div class="flex items-center gap-2 text-success">
                <span aria-hidden="true">✓</span>
                <span>UC-013 · links/tests pass</span>
              </div>
              <div class="mt-2.5 text-body">PR #214 ready</div>
            </div>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

<div
  id="copy-toast"
  role="status"
  aria-live="polite"
  class="pointer-events-none fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 rounded-md border border-primary-deep bg-canvas-raised text-ink-strong text-sm shadow-[0_24px_60px_-32px_rgba(45,212,191,0.4)] opacity-0 transition-opacity duration-200"
>
  복사됨 · IDE 채팅창에 붙여넣으세요
</div>

<script>
  const copyButtons = document.querySelectorAll<HTMLButtonElement>("[data-onboarding-copy-btn], [data-onboarding-cta]");
  const toast = document.getElementById("copy-toast");
  let toastTimer: ReturnType<typeof setTimeout> | undefined;

  function showToast(message: string): void {
    if (!toast) return;
    toast.textContent = message;
    toast.style.opacity = "1";
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.style.opacity = "0";
    }, 2000);
  }

  async function copyPrompt(): Promise<void> {
    const promptEl = document.querySelector<HTMLElement>("[data-onboarding-prompt]");
    if (!promptEl) return;
    const text = promptEl.textContent ?? "";
    try {
      await navigator.clipboard.writeText(text);
      showToast("복사됨 · IDE 채팅창에 붙여넣으세요");
      (window as any).posthog?.capture("prompt_copied");
    } catch {
      showToast("복사 실패 · 수동으로 선택해주세요");
    }
  }

  copyButtons.forEach((btn) => btn.addEventListener("click", copyPrompt));
</script>
