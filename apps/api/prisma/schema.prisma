// vspec — Prisma schema
// Authority: docs/05-data-model.md
//
// This file is a SEED. Extend it; do not rewrite it.
// All 16 MVP entities are stubbed below with required fields and relations.
// Indexes and constraints from docs/05 are preserved.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enum-like fields are stored as strings to keep the MVP schema simple while
// the domain language is still moving.
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// Organization layer
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  github_id     String    @unique
  email         String    @unique
  name          String?
  avatar_url    String?
  last_login_at DateTime?
  created_at    DateTime  @default(now())

  memberships     Membership[]
  ownedWorkspaces Workspace[]    @relation("WorkspaceOwner")
  revisions       Revision[]
  comments        Comment[]
  apiKeys         ApiKey[]
  sessions        WorkSession[]
  locks           Lock[]         @relation("LockHolder")
  mergesCreated   MergeRequest[] @relation("MergeCreator")
  mergesReviewed  MergeRequest[] @relation("MergeReviewer")
}

model Workspace {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  owner_id    String
  plan        String    @default("FREE")
  settings    String    @default("{}")
  archived_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  owner       User         @relation("WorkspaceOwner", fields: [owner_id], references: [id])
  projects    Project[]
  memberships Membership[]
  apiKeys     ApiKey[]
}

model Membership {
  id           String   @id @default(cuid())
  user_id      String
  workspace_id String
  role         String
  joined_at    DateTime @default(now())

  user      User      @relation(fields: [user_id], references: [id])
  workspace Workspace @relation(fields: [workspace_id], references: [id])

  @@unique([user_id, workspace_id])
}

model Project {
  id                String   @id @default(cuid())
  workspace_id      String
  name              String
  key               String
  description       String?
  visibility        String   @default("PRIVATE")
  default_branch_id String?  @unique
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  workspace      Workspace     @relation(fields: [workspace_id], references: [id])
  default_branch SpecBranch?   @relation("ProjectDefaultBranch", fields: [default_branch_id], references: [id])
  actors         Actor[]
  stakeholders   Stakeholder[]
  goals          Goal[]
  usecases       UseCase[]
  branches       SpecBranch[]  @relation("ProjectBranches")
  sessions       WorkSession[]

  @@unique([workspace_id, key])
}

// ─────────────────────────────────────────────────────────────────────────────
// Domain layer
// ─────────────────────────────────────────────────────────────────────────────

model Actor {
  id          String    @id @default(cuid())
  project_id  String
  name        String
  type        String
  description String?
  is_human    Boolean   @default(true)
  aliases     String    @default("[]")
  archived_at DateTime?
  created_at  DateTime  @default(now())

  project    Project   @relation(fields: [project_id], references: [id])
  primaryFor UseCase[] @relation("UseCasePrimaryActor")
  goals      Goal[]
  steps      Step[]

  @@unique([project_id, name])
}

model Stakeholder {
  id          String    @id @default(cuid())
  project_id  String
  name        String
  type        String
  description String?
  archived_at DateTime?
  created_at  DateTime  @default(now())

  project   Project               @relation(fields: [project_id], references: [id])
  interests StakeholderInterest[]

  @@unique([project_id, name])
}

model Goal {
  id                String    @id @default(cuid())
  project_id        String
  actor_id          String
  description       String
  level             String
  status            String    @default("IDENTIFIED")
  linked_usecase_id String?   @unique
  priority          String    @default("P2")
  archived_at       DateTime?
  created_at        DateTime  @default(now())

  project        Project  @relation(fields: [project_id], references: [id])
  actor          Actor    @relation(fields: [actor_id], references: [id])
  linked_usecase UseCase? @relation("GoalLinkedUseCase", fields: [linked_usecase_id], references: [id])
}

model UseCase {
  id                  String    @id @default(cuid())
  project_id          String
  key                 String
  title               String
  level               String
  format              String    @default("FULLY_DRESSED")
  scope               String
  primary_actor_id    String
  trigger             String
  preconditions       String    @default("[]")
  success_guarantee   String
  minimal_guarantee   String
  frequency           String?
  priority            String    @default("P2")
  status              String    @default("DRAFT")
  current_revision_id String?   @unique
  archived_at         DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  project              Project               @relation(fields: [project_id], references: [id])
  primary_actor        Actor                 @relation("UseCasePrimaryActor", fields: [primary_actor_id], references: [id])
  current_revision     Revision?             @relation("UseCaseCurrentRevision", fields: [current_revision_id], references: [id])
  scenarios            Scenario[]
  stakeholderInterests StakeholderInterest[]
  comments             Comment[]
  promotedFromGoal     Goal?                 @relation("GoalLinkedUseCase")

  @@unique([project_id, key])
}

model Scenario {
  id                 String   @id @default(cuid())
  usecase_id         String
  type               String
  extension_point    String?
  parent_step_number Int?
  condition          String?
  outcome            String   @default("SUCCESS")
  order_index        Int      @default(0)
  created_at         DateTime @default(now())

  usecase UseCase @relation(fields: [usecase_id], references: [id])
  steps   Step[]

  @@index([usecase_id])
}

model Step {
  id             String   @id @default(cuid())
  scenario_id    String
  step_number    Int
  actor_id       String
  action         String
  implements     String[] @default([])
  invokes        String[] @default([])
  is_system_step Boolean  @default(false)
  notes          String?
  order_index    Int      @default(0)
  created_at     DateTime @default(now())

  scenario Scenario @relation(fields: [scenario_id], references: [id])
  actor    Actor    @relation(fields: [actor_id], references: [id])

  @@index([scenario_id, step_number])
}

model StakeholderInterest {
  id                   String   @id @default(cuid())
  usecase_id           String
  stakeholder_id       String
  interest             String
  protection_mechanism String?
  created_at           DateTime @default(now())

  usecase     UseCase     @relation(fields: [usecase_id], references: [id])
  stakeholder Stakeholder @relation(fields: [stakeholder_id], references: [id])

  @@unique([usecase_id, stakeholder_id])
}

model Revision {
  id                 String   @id @default(cuid())
  entity_type        String
  entity_id          String
  branch_id          String
  version_number     Int
  content_hash       String
  snapshot           String
  change_summary     String?
  author_id          String
  parent_revision_id String?
  severity           String?
  created_at         DateTime @default(now())

  branch            SpecBranch @relation(fields: [branch_id], references: [id])
  author            User       @relation(fields: [author_id], references: [id])
  parent_revision   Revision?  @relation("RevisionParent", fields: [parent_revision_id], references: [id])
  children          Revision[] @relation("RevisionParent")
  currentForUseCase UseCase?   @relation("UseCaseCurrentRevision")

  @@unique([entity_type, entity_id, branch_id, version_number])
  @@index([entity_type, entity_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Concurrency layer
// ─────────────────────────────────────────────────────────────────────────────

model SpecBranch {
  id                String    @id @default(cuid())
  project_id        String
  name              String
  base_branch_id    String?
  base_revision_ids String    @default("{}")
  head_revision_ids String    @default("{}")
  owner_type        String
  owner_id          String
  purpose           String?
  status            String    @default("ACTIVE")
  created_at        DateTime  @default(now())
  merged_at         DateTime?

  project           Project        @relation("ProjectBranches", fields: [project_id], references: [id])
  base_branch       SpecBranch?    @relation("BranchParent", fields: [base_branch_id], references: [id])
  derivedBranches   SpecBranch[]   @relation("BranchParent")
  defaultForProject Project?       @relation("ProjectDefaultBranch")
  sessions          WorkSession[]
  revisions         Revision[]
  sourceMRs         MergeRequest[] @relation("MergeSourceBranch")
  targetMRs         MergeRequest[] @relation("MergeTargetBranch")

  @@unique([project_id, name])
}

model MergeRequest {
  id               String    @id @default(cuid())
  source_branch_id String
  target_branch_id String
  status           String    @default("OPEN")
  strategy         String
  impact           String    @default("{}")
  conflicts        String    @default("[]")
  created_by       String
  reviewed_by      String?
  created_at       DateTime  @default(now())
  resolved_at      DateTime?

  source_branch SpecBranch @relation("MergeSourceBranch", fields: [source_branch_id], references: [id])
  target_branch SpecBranch @relation("MergeTargetBranch", fields: [target_branch_id], references: [id])
  creator       User       @relation("MergeCreator", fields: [created_by], references: [id])
  reviewer      User?      @relation("MergeReviewer", fields: [reviewed_by], references: [id])
}

model WorkSession {
  id               String    @id @default(cuid())
  project_id       String
  user_id          String
  agent_type       String    @default("HUMAN")
  agent_identifier String?
  intent           String
  pinned_revisions String    @default("{}")
  branch_id        String?
  status           String    @default("ACTIVE")
  started_at       DateTime  @default(now())
  last_activity_at DateTime?
  ended_at         DateTime?

  project Project     @relation(fields: [project_id], references: [id])
  user    User        @relation(fields: [user_id], references: [id])
  branch  SpecBranch? @relation(fields: [branch_id], references: [id])
  locks   Lock[]

  @@index([project_id, status])
}

model Lock {
  id                 String   @id @default(cuid())
  target_type        String
  target_id          String
  lock_type          String
  held_by_session_id String?
  held_by_user_id    String
  reason             String
  acquired_at        DateTime @default(now())
  expires_at         DateTime
  auto_release       Boolean  @default(true)

  session WorkSession? @relation(fields: [held_by_session_id], references: [id])
  user    User         @relation("LockHolder", fields: [held_by_user_id], references: [id])

  @@unique([target_type, target_id, lock_type, held_by_session_id, held_by_user_id])
  @@index([target_type, target_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Collaboration layer
// ─────────────────────────────────────────────────────────────────────────────

model Comment {
  id          String    @id @default(cuid())
  target_type String    @default("USECASE")
  target_id   String
  author_id   String
  body        String
  resolved    Boolean   @default(false)
  created_at  DateTime  @default(now())
  resolved_at DateTime?
  updated_at  DateTime?

  author  User    @relation(fields: [author_id], references: [id])
  usecase UseCase @relation(fields: [target_id], references: [id])

  @@index([target_type, target_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth (operational; not in the 16-entity core but needed for MVP runtime)
// ─────────────────────────────────────────────────────────────────────────────

model ApiKey {
  id           String    @id @default(cuid())
  workspace_id String
  user_id      String
  name         String
  key_hash     String    @unique
  scopes       String    @default("[]")
  last_used_at DateTime?
  expires_at   DateTime?
  revoked_at   DateTime?
  created_at   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id])
  user      User      @relation(fields: [user_id], references: [id])

  @@index([workspace_id])
}
