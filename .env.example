# Copy to .env. Values shown are local dogfood defaults that work without Docker.

# --- Database ---
DATABASE_URL=file:.state/dev.sqlite
# Tests create isolated SQLite files unless a test explicitly overrides this.
TEST_DATABASE_URL=file:.state/test.sqlite
# Production deploys override DATABASE_URL with Postgres; see docker-compose.prod.yml.

# --- HTTP server ---
VSPEC_PORT=4455
VSPEC_LOG_LEVEL=info

# --- CLI ---
VSPEC_PROFILE=default
VSPEC_API_URL=http://localhost:4455

# --- Auth (production) ---
# Required in non-stub mode. Get from https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Auth (dev / test / dogfood) ---
# Set to 1 to enable stubbed OAuth (rejects when NODE_ENV=production).
VSPEC_AUTH_STUB=1
