---
const navLinks = [
  { label: "기능", href: "#features" },
  { label: "워크플로우", href: "#how" },
  { label: "사용 예시", href: "#showcase" },
  { label: "가격", href: "#pricing" },
];
---

<header class="hero">
  <nav class="hero__nav" aria-label="주요 메뉴">
    <div class="section-shell hero__nav-inner">
      <a class="hero__brand" href="#top" aria-label="Vooster 홈">
        <span class="hero__brand-mark" aria-hidden="true"></span>
        <span class="hero__brand-word">vooster</span>
        <span class="hero__brand-tag">/ko</span>
      </a>
      <ul class="hero__nav-links">
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
      <div class="hero__nav-cta">
        <a class="btn btn--ghost hero__nav-ghost" href="https://github.com/vibemafiaclub/vooster" rel="noopener">
          GitHub
        </a>
        <a class="btn btn--primary" href="#pricing">시작하기</a>
      </div>
    </div>
  </nav>

  <section id="top" class="hero__band" aria-labelledby="hero-title">
    <div class="section-shell hero__content">
      <span class="pill hero__pill">
        <span class="pill__dot" aria-hidden="true"></span>
        v0.1 · 한국어 우선
      </span>
      <p class="eyebrow-mono">WORKSPACE FOR AGENTS &amp; HUMANS</p>
      <h1 id="hero-title" class="hero__title">
        팀과 에이전트가<br />
        같은 맥락에서 <em>움직입니다</em>.
      </h1>
      <p class="hero__copy">
        Vooster는 한국어 유스케이스, 빨간 테스트, 커밋 이력을 한 작업실에 모읍니다.
        6개 이상의 AI 에이전트가 동시에 편집해도 누구도 맥락을 잃지 않습니다.
      </p>
      <div class="hero__actions" aria-label="주요 작업">
        <a class="btn btn--primary" href="#pricing">
          무료로 시작하기
          <span aria-hidden="true">→</span>
        </a>
        <a class="btn btn--outline" href="#showcase">사용 예시 보기</a>
      </div>
      <ul class="hero__stats" aria-label="현재 진행">
        <li>
          <span class="hero__stat-num mono-num">35</span>
          <span class="hero__stat-label">완료된 유스케이스</span>
        </li>
        <li>
          <span class="hero__stat-num mono-num">475</span>
          <span class="hero__stat-label">통과 테스트</span>
        </li>
        <li>
          <span class="hero__stat-num mono-num">6</span>
          <span class="hero__stat-label">합격 게이트 단계</span>
        </li>
      </ul>
    </div>

    <div class="section-shell hero__mockup-shell">
      <article class="hero__mockup" aria-label="Vooster CLI 미리보기">
        <header class="hero__mockup-bar">
          <span class="hero__mockup-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
          <span class="hero__mockup-file">~/vooster · vspec spec ls</span>
          <span class="pill hero__mockup-pill" aria-label="실시간 상태">
            <span class="pill__dot" aria-hidden="true"></span>
            live
          </span>
        </header>
        <pre class="hero__mockup-code"><code><span class="c-mute">$</span> <span class="c-key">vspec</span> spec ls --workspace=team
<span class="c-mute">┌──────────┬──────────────────────────┬─────────────┐</span>
<span class="c-mute">│</span> <span class="c-key">UC-012</span>   <span class="c-mute">│</span> 리뷰 요청 보내기         <span class="c-mute">│</span> <span class="c-warn">● red</span>     <span class="c-mute">│</span>
<span class="c-mute">│</span> <span class="c-key">UC-013</span>   <span class="c-mute">│</span> GitHub OAuth 로그인      <span class="c-mute">│</span> <span class="c-ok">● green</span>   <span class="c-mute">│</span>
<span class="c-mute">│</span> <span class="c-key">UC-014</span>   <span class="c-mute">│</span> 세션 타임라인            <span class="c-mute">│</span> <span class="c-accent">● gated</span>   <span class="c-mute">│</span>
<span class="c-mute">└──────────┴──────────────────────────┴─────────────┘</span>
<span class="c-mute">→</span> <span class="c-accent">3</span> use cases · 빨강 1 · 초록 1 · 게이트 통과 1
</code></pre>
      </article>
    </div>
  </section>
</header>

<style>
  .hero {
    position: relative;
    background: var(--color-canvas);
    border-bottom: var(--hairline);
  }

  .hero__nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(12, 16, 14, 0.86);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: var(--hairline);
  }

  .hero__nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xl);
    height: 64px;
  }

  .hero__brand {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink-strong);
  }

  .hero__brand-mark {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--color-primary);
    box-shadow: 0 0 0 4px rgba(45, 212, 191, 0.18);
    align-self: center;
  }

  .hero__brand-tag {
    color: var(--color-mute);
    font-size: 12px;
  }

  .hero__nav-links {
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-body);
    font-size: 14px;
  }

  .hero__nav-links a {
    transition: color 140ms ease-out;
  }

  .hero__nav-links a:hover {
    color: var(--color-ink-strong);
  }

  .hero__nav-cta {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hero__nav-ghost {
    min-height: 40px;
    padding: 10px 14px;
    font-size: 14px;
  }

  .hero__nav-cta .btn--primary {
    min-height: 40px;
    padding: 10px 16px;
    font-size: 14px;
  }

  .hero__band {
    padding: var(--space-8xl) 0 var(--space-7xl);
    position: relative;
    overflow: hidden;
  }

  .hero__band::before {
    content: "";
    position: absolute;
    inset: -20% 30% auto auto;
    height: 540px;
    width: 540px;
    background: radial-gradient(
      circle at center,
      rgba(45, 212, 191, 0.12) 0%,
      rgba(45, 212, 191, 0) 60%
    );
    filter: blur(20px);
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 860px;
  }

  .hero__pill {
    margin-bottom: var(--space-2xl);
  }

  .hero__title {
    margin: 0;
    color: var(--color-ink-strong);
    font-family: var(--font-sans);
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.02;
  }

  .hero__title em {
    font-style: normal;
    color: var(--color-primary-soft);
  }

  .hero__copy {
    max-width: 620px;
    margin: var(--space-3xl) 0 0;
    color: var(--color-body);
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: var(--space-4xl) 0 0;
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2xl);
    max-width: 540px;
    margin: var(--space-6xl) 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__stats li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 14px;
    border-left: 1px solid var(--color-hairline);
  }

  .hero__stat-num {
    color: var(--color-ink-strong);
    font-size: 1.6rem;
    line-height: 1;
  }

  .hero__stat-label {
    color: var(--color-mute);
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .hero__mockup-shell {
    position: relative;
    z-index: 1;
    margin-top: var(--space-7xl);
  }

  .hero__mockup {
    border: var(--hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas-soft);
    box-shadow:
      0 0 0 1px rgba(45, 212, 191, 0.06),
      0 24px 60px -32px rgba(45, 212, 191, 0.18);
    overflow: hidden;
  }

  .hero__mockup-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 12px 16px;
    border-bottom: var(--hairline);
    background: var(--color-canvas);
  }

  .hero__mockup-dots {
    display: inline-flex;
    gap: 6px;
  }

  .hero__mockup-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-hairline);
  }

  .hero__mockup-file {
    flex: 1;
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 12px;
    text-align: center;
  }

  .hero__mockup-pill {
    font-size: 11px;
    padding: 4px 10px;
  }

  .hero__mockup-code {
    margin: 0;
    padding: var(--space-2xl);
    background: var(--color-canvas);
    color: var(--color-code-ink);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    overflow-x: auto;
  }

  .hero__mockup-code .c-key {
    color: var(--color-primary-soft);
  }

  .hero__mockup-code .c-mute {
    color: var(--color-mute);
  }

  .hero__mockup-code .c-accent {
    color: var(--color-primary);
  }

  .hero__mockup-code .c-ok {
    color: var(--color-success);
  }

  .hero__mockup-code .c-warn {
    color: var(--color-error);
  }

  @media (max-width: 880px) {
    .hero__nav-links {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero__band {
      padding: var(--space-7xl) 0 var(--space-6xl);
    }

    .hero__nav-ghost {
      display: none;
    }

    .hero__title {
      font-size: clamp(2.25rem, 9vw, 3rem);
    }

    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__actions .btn {
      width: 100%;
    }

    .hero__stats {
      grid-template-columns: 1fr 1fr;
    }

    .hero__stats li:last-child {
      grid-column: span 2;
    }

    .hero__mockup-code {
      font-size: 11.5px;
    }
  }
</style>
