---
const steps = [
  {
    n: "01",
    pain: "AI가 기획의 빈칸을 마음대로 채우는 문제",
    body: "한국어 자연어로 쓴 기획을 유스케이스 형식으로 구조화해, 이해관계자·목표·시나리오·확장을 1급 필드로 박습니다. 빈칸 자체가 사라지므로, AI가 해석으로 채울 여지가 없습니다.",
    visual: "spec",
  },
  {
    n: "02",
    pain: "멀티 에이전트 환경에서 스펙이 꼬이는 문제",
    body: "여러 에이전트가 동시에 작업을 하다보면 문서도, 코드도 꼬이기 쉽습니다. Vooster는 작업중인 기능을 Lock 상태로 전환해서, 다른 에이전트가 침범할 수 없게 만듭니다. 결과적으로 몇십 개의 에이전트도 충돌없이 작업할 수 있게 됩니다.",
    visual: "lock",
  },
  {
    n: "03",
    pain: "AI가 spec 일부를 빼먹어도 모르는 문제",
    body: "시간이 지나면 코드와 spec은 따로 놀게 됩니다. spec은 점점 거짓말이 되고, \"분명히 시켰는데\"가 반복됩니다. Vooster는 spec과 코드의 일치를 CI에서 자동 검증해, 어긋난 PR을 통과시키지 않습니다.",
    visual: "drift",
  },
] as const;
---

<section id="how" class="section bg-canvas">
  <div class="shell">
    <div class="max-w-[760px]">
      <p class="eyebrow">HOW IT WORKS</p>
      <h2 class="section-heading">
        바이브코딩을<br />
        <em>spec-driven coding</em>으로 바꾸는 3단계.
      </h2>
    </div>

    <ol class="mt-16 grid gap-5 md:grid-cols-3 list-none p-0">
      {steps.map((step) => (
        <li class="card flex flex-col gap-5 p-7 hover:border-primary-deep">
          <header class="flex items-baseline gap-3">
            <span class="mono-num text-primary-soft text-2xl">{step.n}</span>
            <span class="text-mute font-mono text-[11px] font-semibold uppercase tracking-[0.14em]">
              Problem → Fix
            </span>
          </header>

          <h3 class="text-ink-strong text-lg font-semibold tracking-tight leading-snug m-0">
            {step.pain}
          </h3>

          <p class="text-body text-[15px] leading-relaxed m-0">
            {step.body}
          </p>

          <div class="mt-auto pt-2">
            {step.visual === "spec" && (
              <pre class="m-0 p-4 bg-canvas-raised border border-hairline rounded-sm text-code-ink font-mono text-[11.5px] leading-[1.65] overflow-x-auto"><code><span class="text-mute">specs/UC-013.md</span>
<span class="text-primary-soft"># UC-013</span> GitHub OAuth
  Goal:  30초 안에 로그인
  Actor: 미로그인 방문자
  Steps:
   1. /login 접속
   2. GitHub 인증 ...</code></pre>
            )}

            {step.visual === "lock" && (
              <div class="p-4 bg-canvas-raised border border-hairline rounded-sm font-mono text-[12px] leading-relaxed">
                <div class="flex items-center gap-2 text-ink-strong">
                  <span aria-hidden="true">🔒</span>
                  <span>UC-013 · Locked</span>
                </div>
                <div class="mt-2.5 text-body">claude-code 작업 중 (45m)</div>
                <div class="text-body">cursor 침범 2회 차단</div>
              </div>
            )}

            {step.visual === "drift" && (
              <div class="p-4 bg-canvas-raised border border-error/40 rounded-sm font-mono text-[12px] leading-relaxed">
                <div class="flex items-center gap-2 text-error">
                  <span aria-hidden="true">❌</span>
                  <span>spec drift detected</span>
                </div>
                <div class="mt-2.5 text-body">UC-013 · step 3 미구현</div>
                <div class="text-body">PR #214 blocked</div>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
