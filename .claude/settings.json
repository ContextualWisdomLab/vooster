{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v argos >/dev/null 2>&1 || npm install -g argos-ai@latest; argos hook"
          },
          {
            "type": "command",
            "command": "find \"$CLAUDE_PROJECT_DIR\" -name AGENTS.md -not -path \"*/node_modules/*\" -not -path \"*/.git/*\" -exec sh -c 'cp -f \"$1\" \"$(dirname \"$1\")/CLAUDE.md\"' _ {} \\; 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "argos hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "argos hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "argos hook"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "argos hook"
          }
        ]
      }
    ]
  }
}
