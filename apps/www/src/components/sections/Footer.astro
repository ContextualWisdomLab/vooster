---
const columns = [
  {
    title: "제품",
    links: [
      { label: "진단", href: "#intro" },
      { label: "워크플로우", href: "#how" },
      { label: "시작하기", href: "#get-started" },
      { label: "FAQ", href: "#faq" },
    ],
  },
  {
    title: "리소스",
    links: [
      { label: "문서", href: "https://github.com/vibemafiaclub/vooster/tree/main/docs" },
      { label: "AGENTS.md", href: "https://github.com/vibemafiaclub/vooster/blob/main/AGENTS.md" },
      { label: "GitHub", href: "https://github.com/vibemafiaclub/vooster" },
      { label: "릴리스 노트", href: "https://github.com/vibemafiaclub/vooster/releases" },
    ],
  },
  {
    title: "회사",
    links: [
      { label: "문의", href: "mailto:hello@vooster.local" },
      { label: "보안", href: "mailto:security@vooster.local" },
      { label: "Discord", href: "#" },
      { label: "이용약관", href: "#" },
    ],
  },
];
---

<footer class="bg-canvas border-t border-hairline text-body pt-16 md:pt-20 pb-10">
  <div class="shell">
    <div class="grid gap-12 md:gap-16 md:grid-cols-[minmax(0,1.1fr)_minmax(0,2fr)] pb-12 border-b border-hairline">
      <div class="flex flex-col gap-4 max-w-[360px]">
        <a href="#top" class="inline-flex items-baseline gap-2 font-mono text-[18px] font-semibold text-ink-strong tracking-tight" aria-label="Vooster 홈">
          <svg
            viewBox="0 0 160 160"
            width="26"
            height="26"
            class="self-center text-primary drop-shadow-[0_0_8px_rgba(45,212,191,0.35)]"
            fill="none"
            aria-hidden="true"
          >
            <circle cx="80" cy="80" r="72.7273" stroke="currentColor" stroke-width="14.5455" />
            <path d="M88.8889 44.4434L53.3333 79.9989H106.667L71.1111 115.554" stroke="currentColor" stroke-width="17.7778" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>vooster</span>
          <span class="text-mute text-[13px]">/ko</span>
        </a>
        <p class="m-0 text-body text-[15px] leading-[1.6]">
          요구사항과 테스트가 같은 방향을 보게 하는<br />
          한국어 유스케이스 작업실.
        </p>
        <div>
          <span class="pill">
            <span class="pill-dot" aria-hidden="true"></span>
            모든 게이트 통과 · 2026-05-21
          </span>
        </div>
      </div>

      <nav class="grid grid-cols-2 md:grid-cols-3 gap-10 md:gap-12" aria-label="푸터 메뉴">
        {columns.map((col) => (
          <div>
            <p class="m-0 mb-4 text-mute font-mono text-[11px] font-semibold uppercase tracking-[0.18em]">
              {col.title}
            </p>
            <ul class="m-0 p-0 list-none grid gap-2.5">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="text-ink text-sm transition-colors duration-150 hover:text-primary-soft">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 pt-6">
      <small class="text-mute text-xs">© 2026 Vooster · MIT License</small>
      <small class="text-mute text-xs mono-num">
        build: <span class="text-primary-soft">main@8a0e184</span> · v0.1
      </small>
    </div>
  </div>
</footer>
