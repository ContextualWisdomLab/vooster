---
const partners = [
  { name: "GitHub", desc: "이슈·PR 동기화" },
  { name: "Fastify", desc: "API 런타임" },
  { name: "Prisma", desc: "스키마 + DB" },
  { name: "Vitest", desc: "테스트 러너" },
  { name: "oclif", desc: "CLI 프레임워크" },
  { name: "Astro", desc: "랜딩 빌드" },
];
---

<section class="logos" aria-labelledby="logos-title">
  <div class="section-shell">
    <p class="eyebrow-mono">BUILT ON OPEN SOURCE</p>
    <h2 id="logos-title" class="logos__heading">
      팀이 이미 쓰는 도구 위에 자연스럽게 얹힙니다.
    </h2>
    <ul class="logos__grid" aria-label="연동 기술">
      {partners.map((partner) => (
        <li class="logos__cell">
          <span class="logos__name">{partner.name}</span>
          <span class="logos__desc">{partner.desc}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .logos {
    padding: var(--space-6xl) 0;
    background: var(--color-canvas);
    border-bottom: var(--hairline);
  }

  .logos__heading {
    margin: 0 0 var(--space-4xl);
    max-width: 640px;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .logos__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border: var(--hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-canvas);
  }

  .logos__cell {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    min-height: 96px;
    padding: var(--space-xl) var(--space-lg);
    border-right: var(--hairline);
    transition: background 200ms ease-out;
  }

  .logos__cell:last-child {
    border-right: none;
  }

  .logos__cell:hover {
    background: var(--color-canvas-soft);
  }

  .logos__name {
    color: var(--color-ink-strong);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .logos__desc {
    color: var(--color-mute);
    font-size: 12px;
    letter-spacing: 0.01em;
  }

  @media (max-width: 960px) {
    .logos__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .logos__cell:nth-child(3n) {
      border-right: none;
    }

    .logos__cell:nth-child(n + 4) {
      border-top: var(--hairline);
    }
  }

  @media (max-width: 560px) {
    .logos__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .logos__cell {
      border-right: var(--hairline);
    }

    .logos__cell:nth-child(2n) {
      border-right: none;
    }

    .logos__cell:nth-child(n + 3) {
      border-top: var(--hairline);
    }
  }
</style>
