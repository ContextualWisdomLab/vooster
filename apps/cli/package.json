{
  "name": "@vooster/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "vspec": "./bin/run.js"
  },
  "scripts": {
    "build": "cd ../.. && tsc -p tsconfig.json",
    "test": "cd ../.. && vitest run apps/cli/tests",
    "test:e2e": "cd ../.. && vitest run apps/cli/tests/e2e-cli apps/cli/tests/e2e-cli-honest",
    "test:unit": "cd ../.. && vitest run apps/cli/tests/unit",
    "test:coverage": "cd ../.. && vitest run --config vitest.cli-unit.config.ts --coverage",
    "typecheck": "cd ../.. && tsc -p tsconfig.json --noEmit"
  }
}
