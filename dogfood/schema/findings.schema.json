{
  "type": "object",
  "required": ["case_id", "summary", "task_succeeded", "findings"],
  "properties": {
    "case_id": { "type": "string" },
    "summary": { "type": "string" },
    "task_succeeded": { "type": "boolean" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "title", "description", "routing"],
        "properties": {
          "severity": { "enum": ["P0", "P1", "P2"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "routing": { "enum": ["claude", "codex"] }
        }
      }
    }
  }
}
