---
import Features from "../components/sections/Features.astro";
import Footer from "../components/sections/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import LogoCloud from "../components/sections/LogoCloud.astro";
import Pricing from "../components/sections/Pricing.astro";
import Showcase from "../components/sections/Showcase.astro";
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Vooster는 한국어 유스케이스와 테스트 흐름을 한곳에서 관리하는 개발 작업실입니다."
    />
    <title>Vooster - 한국어 유스케이스 작업실</title>
  </head>
  <body>
    <main>
      <Hero />
      <LogoCloud />
      <Features />
      <HowItWorks />
      <Showcase />
      <Pricing />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    color: #17201c;
    background: #f7f4ee;
    font-family:
      Inter, Pretendard, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.5;
    text-rendering: optimizeLegibility;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-width: 320px;
    background:
      linear-gradient(180deg, rgba(247, 244, 238, 0) 0%, #f7f4ee 68%),
      #f7f4ee;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input,
  textarea {
    font: inherit;
  }

  .section-shell {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .section-kicker {
    margin: 0 0 12px;
    color: #0f766e;
    font-size: 0.82rem;
    font-weight: 800;
  }

  .section-heading {
    margin: 0;
    max-width: 760px;
    color: #17201c;
    font-size: clamp(2rem, 5vw, 3.7rem);
    line-height: 1.05;
  }

  .section-copy {
    margin: 18px 0 0;
    max-width: 660px;
    color: #536057;
    font-size: 1.04rem;
  }

  @media (max-width: 720px) {
    .section-shell {
      width: min(100% - 24px, 1120px);
    }
  }
</style>
