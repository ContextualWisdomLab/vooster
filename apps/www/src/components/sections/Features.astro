---
const features = [
  {
    title: "유스케이스 중심 작업",
    body: "성공 시나리오, 확장 흐름, 보증 조건을 구현 단위와 함께 유지합니다.",
  },
  {
    title: "테스트 우선 진행",
    body: "빨간 테스트, 최소 구현, 리팩터링 기록이 같은 맥락에 남습니다.",
  },
  {
    title: "에이전트 세션 기록",
    body: "누가 어떤 목표로 무엇을 검증했는지 다음 작업자가 바로 이어받습니다.",
  },
  {
    title: "커밋 단위 추적",
    body: "작은 변경의 이유와 검증 결과를 유스케이스별로 연결합니다.",
  },
  {
    title: "게이트 기반 품질",
    body: "목표 파일과 게이트 스크립트가 완료 조건을 기계적으로 확인합니다.",
  },
  {
    title: "오픈소스 공개 준비",
    body: "비밀값, 로컬 산출물, 임시 상태가 기록에 섞이지 않도록 점검합니다.",
  },
];
---

<section class="features" aria-labelledby="features-title">
  <div class="section-shell">
    <p class="section-kicker">핵심 기능</p>
    <h2 id="features-title" class="section-heading">요구사항이 코드로 바뀌는 경로를 보이게 합니다</h2>
    <div class="features__grid">
      {
        features.map((feature) => (
          <article>
            <span class="feature-mark" aria-hidden="true"></span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    padding: 78px 0;
    background: #fffaf1;
  }

  .features__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 34px;
  }

  article {
    min-height: 218px;
    border: 1px solid #ded6c7;
    border-radius: 8px;
    padding: 24px;
    background: #ffffff;
  }

  .feature-mark {
    display: block;
    width: 34px;
    height: 5px;
    border-radius: 999px;
    background: #0f766e;
  }

  h3 {
    margin: 28px 0 10px;
    color: #17201c;
    font-size: 1.15rem;
  }

  p {
    margin: 0;
    color: #536057;
  }

  @media (max-width: 920px) {
    .features__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .features__grid {
      grid-template-columns: 1fr;
    }

    article {
      min-height: auto;
    }
  }
</style>
