# Node
node_modules/
npm-debug.log*
pnpm-debug.log*
*.log
.npm

form-data/

# Builds
dist/
**/dist/
build/
.next/
*.tsbuildinfo
.astro/
.turbo/
.cache/
tmp/

# Environments
.env
.env.local
.env.*.local
.env.*
!.env.example

# Test artifacts
coverage/
.vitest/
*.lcov
.nyc_output/
.stryker-tmp/
test-results/
playwright-report/
playwright/.cache/

# Local agent state (kept ignored to avoid leaking between agent runs)
.state/

# Dogfood loop per-cycle artifacts (sessions, spec snapshots) — see docs/dogfood-loop.md
dogfood/runs/
.vspec/cache/
.vspec/session.json
.vspec/sync-state.json
# CLI auto-export materializes server specs into <root>/specs/ on each
# mutating verb. In test runs without --root, the working tree becomes
# the root, leaking spec files here that are not source.
/specs/
.omc/

# Vercel (contains projectId/orgId — Vercel docs say do not commit)
.vercel/

# Generated from AGENTS.md by SessionStart hook
CLAUDE.md

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*.swo

# Secrets
*.pem
*.key
*.p12

# Prisma
prisma/migrations/*/migration_lock.toml
prisma/.state/

.claude/skills/**/token.txt
