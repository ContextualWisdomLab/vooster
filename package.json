{
  "name": "vooster",
  "version": "1.0.0",
  "description": "Cockburn-style use case management for environments with **6+ concurrent AI coding agents**.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vspec": "./bin/run.js"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "tsc",
    "predev": "if [ -n \"${DATABASE_URL:-}\" ]; then prisma db push --skip-generate; fi",
    "dev": "tsx watch src/index.ts",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "prestart": "if [ -n \"${DATABASE_URL:-}\" ]; then prisma db push --skip-generate; fi",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibemafiaclub/vooster.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/vibemafiaclub/vooster/issues"
  },
  "homepage": "https://github.com/vibemafiaclub/vooster#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/client": "^5.22.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^20.19.41",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "prettier": "^3.8.3",
    "prisma": "^5.22.0",
    "tsx": "^4.22.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@oclif/core": "^4.11.3",
    "argon2": "^0.44.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^4.29.1",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.3",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
