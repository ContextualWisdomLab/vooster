# Copy to .env. Values shown are local-dev defaults that work with docker-compose.

# --- Database ---
DATABASE_URL=postgres://vspec:vspec@localhost:5432/vspec
# Tests use a separate DB on port 5433 (see docker-compose.yml `db_test`).
TEST_DATABASE_URL=postgres://vspec:vspec@localhost:5433/vspec_test

# --- HTTP server ---
VSPEC_PORT=4455
VSPEC_LOG_LEVEL=info

# --- CLI ---
VSPEC_PROFILE=default
VSPEC_API_URL=http://localhost:4455

# --- Auth (production) ---
# Required in non-stub mode. Get from https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Auth (dev / test / dogfood) ---
# Set to 1 to enable stubbed OAuth (rejects when NODE_ENV=production).
VSPEC_AUTH_STUB=1
