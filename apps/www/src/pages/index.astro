---
import "../styles/global.css";
import PostHog from "../components/posthog.astro";
import Compatible from "../components/sections/Compatible.astro";
import EndCTA from "../components/sections/EndCTA.astro";
import FAQ from "../components/sections/FAQ.astro";
import Footer from "../components/sections/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import Intro from "../components/sections/Intro.astro";
import Onboarding from "../components/sections/Onboarding.astro";

const siteUrl = "https://v2.vooster.ai";
const canonicalUrl = `${siteUrl}/`;
const ogImageUrl = `${siteUrl}/og.svg`;
const pageTitle = "Vooster — AI 에이전트를 위한 기획·하네스 도구";
const pageDescription =
  "자연어 프롬프트를 구조화된 스펙으로. 느낌으로 하는 바이브코딩은 이제 그만.";
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#0c100e" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="any" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vooster" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vooster — Spec manager for vibe coders" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Vooster — Spec manager for vibe coders" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <PostHog />
  </head>
  <body>
    <main>
      <Hero />
      <Compatible />
      <Intro />
      <HowItWorks />
      <Onboarding />
      <FAQ />
      <EndCTA />
    </main>
    <Footer />
  </body>
</html>
