---
const navLinks = [
  { label: "진단", href: "#intro" },
  { label: "워크플로우", href: "#how" },
  { label: "시작하기", href: "#get-started" },
  { label: "FAQ", href: "#faq" },
];

const stages = [
  {
    kind: "prompt",
    icon: "💬",
    label: "당신",
    body: '"로그인 만들어줘"',
  },
  {
    kind: "spec",
    icon: "📄",
    label: "vspec",
    chip: "specs/UC-013.md",
    code: true,
  },
  {
    kind: "result",
    icon: "✓",
    label: "agent",
    chip: "PR #214",
    body: "UC-013 · 6/6 steps",
    meta: "git: feat(login): add github oauth",
  },
] as const;
---

<header class="relative bg-canvas border-b border-hairline">
  <nav class="sticky top-0 z-10 bg-canvas/85 backdrop-blur border-b border-hairline" aria-label="주요 메뉴">
    <div class="shell flex items-center justify-between gap-6 h-16">
      <a href="#top" class="inline-flex items-baseline gap-2 font-mono text-[15px] font-semibold tracking-tight text-ink-strong" aria-label="Vooster 홈">
        <span class="w-2.5 h-2.5 self-center rounded-[2px] bg-primary shadow-[0_0_0_4px_rgba(45,212,191,0.18)]" aria-hidden="true"></span>
        <span>vooster</span>
        <span class="text-mute text-xs">/ko</span>
      </a>

      <ul class="hidden md:flex gap-7 m-0 p-0 list-none text-body text-sm">
        {navLinks.map((link) => (
          <li><a href={link.href} class="transition-colors hover:text-ink-strong">{link.label}</a></li>
        ))}
      </ul>

      <div class="flex items-center gap-2">
        <a href="https://github.com/vibemafiaclub/vooster" rel="noopener" class="hidden sm:inline-flex btn-ghost min-h-10 px-3.5 py-2.5 text-sm">
          GitHub
        </a>
        <a href="#get-started" class="btn-primary min-h-10 px-4 py-2.5 text-sm">시작하기</a>
      </div>
    </div>
  </nav>

  <section id="top" class="relative overflow-hidden pt-32 pb-24 md:pt-32 md:pb-24" aria-labelledby="hero-title">
    <div
      class="absolute -top-[20%] right-[30%] w-[540px] h-[540px] rounded-full blur-[20px] pointer-events-none"
      style="background: radial-gradient(circle at center, rgba(45,212,191,0.12) 0%, rgba(45,212,191,0) 60%);"
      aria-hidden="true"
    ></div>

    <div class="shell relative max-w-[860px]">
      <span class="pill mb-6">
        <span class="pill-dot" aria-hidden="true"></span>
        v0.1 · 한국어 우선
      </span>
      <p class="eyebrow">SPEC MANAGER FOR VIBE CODERS</p>
      <h1
        id="hero-title"
        class="text-ink-strong font-normal tracking-tight m-0"
        style="font-size: clamp(2.75rem, 7vw, 5.5rem); line-height: 1.06; letter-spacing: -0.025em;"
      >
        “이게 아닌데”를<br />
        오늘 몇 번 <em class="not-italic text-primary-soft">말하셨나요</em>?
      </h1>
      <p class="max-w-[620px] mt-8 text-body text-lg leading-[1.65]">
        Vooster는 vibe coder를 위한 Spec 관리자입니다.<br class="hidden sm:inline" />
        AI가 기획을 맘대로 해석할 여지를 없앱니다.
      </p>
      <div class="flex flex-wrap gap-3 mt-10">
        <a href="#get-started" class="btn-primary">
          무료로 시작
          <span aria-hidden="true">→</span>
        </a>
        <a href="#how" class="btn-outline">3분 데모</a>
      </div>
    </div>

    <div class="shell relative max-w-[720px] mt-24">
      <ol class="flex flex-col items-center gap-3 m-0 p-0 list-none" aria-label="Vooster 워크플로우 미리보기">
        {stages.map((stage, idx) => (
          <>
            <li class:list={[
              "w-full px-6 py-5 rounded-md border transition-colors",
              stage.kind === "spec"
                ? "border-primary-deep bg-canvas shadow-[0_0_0_1px_rgba(45,212,191,0.06),0_24px_60px_-32px_rgba(45,212,191,0.2)]"
                : "border-hairline bg-canvas-soft",
            ]}>
              <header class="flex items-center gap-2.5 mb-3">
                <span class:list={[
                  "inline-flex items-center justify-center w-7 h-7 rounded-sm border text-sm leading-none",
                  stage.kind === "result"
                    ? "bg-success/15 border-success/40 text-success font-bold"
                    : "bg-canvas border-hairline",
                ]} aria-hidden="true">
                  {stage.icon}
                </span>
                <span class="text-mute font-mono text-[11px] font-semibold uppercase tracking-[0.14em]">
                  {stage.label}
                </span>
                {"chip" in stage && (
                  <span class="code-chip ml-auto text-[11px]">{stage.chip}</span>
                )}
              </header>

              {stage.kind === "prompt" && (
                <p class="m-0 text-ink-strong text-lg font-medium leading-snug">{stage.body}</p>
              )}

              {stage.kind === "spec" && (
                <pre class="m-0 p-4 bg-canvas border border-hairline rounded-sm text-code-ink font-mono text-[12.5px] leading-[1.7] overflow-x-auto"><code><span class="text-mute"># UC-013 GitHub OAuth 로그인</span>
<span class="text-primary-soft">Goal:</span>   30초 안에 OAuth 로그인
<span class="text-primary-soft">Actor:</span>  미로그인 방문자
<span class="text-primary-soft">Main success:</span>
  1. /login 접속
  2. GitHub 인증 ...</code></pre>
              )}

              {stage.kind === "result" && (
                <p class="m-0 text-ink-strong leading-snug">
                  {stage.body}<br />
                  <span class="mono-num inline-block mt-1.5 text-mute text-xs">{stage.meta}</span>
                </p>
              )}
            </li>

            {idx < stages.length - 1 && (
              <li class="text-hairline font-mono text-lg leading-none select-none" aria-hidden="true">↓</li>
            )}
          </>
        ))}
      </ol>
    </div>
  </section>
</header>
