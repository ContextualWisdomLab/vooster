---
const rows = [
  { code: "UC-012", title: "리뷰 요청 보내기", status: "red", label: "빨간 테스트 작성 중", who: "agent-A" },
  { code: "UC-013", title: "GitHub OAuth 로그인", status: "green", label: "GREEN 커밋 통과", who: "agent-B" },
  { code: "UC-014", title: "세션 타임라인", status: "gated", label: "게이트 4/6", who: "agent-C" },
  { code: "UC-021", title: "스펙 머지 충돌 해결", status: "lock", label: "SEMANTIC 락", who: "human-sumin" },
];

const statusMap = {
  red: { tone: "var(--color-error)", chip: "빨강" },
  green: { tone: "var(--color-success)", chip: "초록" },
  gated: { tone: "var(--color-primary)", chip: "게이트" },
  lock: { tone: "var(--color-warn)", chip: "락" },
};
---

<section id="showcase" class="showcase" aria-labelledby="showcase-title">
  <div class="section-shell showcase__layout">
    <div class="showcase__copy">
      <p class="eyebrow-mono">USE IN PRACTICE</p>
      <h2 id="showcase-title" class="section-heading">
        요구사항, 테스트, 변경 이력을<br />
        <em>한 화면</em>에서 비교합니다.
      </h2>
      <p class="section-copy">
        프로젝트 리더는 진행 중인 유스케이스를 보고, 개발자는 실패한 테스트를 바로 찾아가며,
        다음 에이전트는 이전 세션의 판단을 놓치지 않습니다.
      </p>
      <ul class="showcase__bullets">
        <li>
          <span class="showcase__bullet-mark" aria-hidden="true"></span>
          한 유스케이스가 어느 단계인지 한 줄로 보입니다.
        </li>
        <li>
          <span class="showcase__bullet-mark" aria-hidden="true"></span>
          빨간 테스트 → GREEN 커밋 → 게이트 통과 흐름이 끊기지 않습니다.
        </li>
        <li>
          <span class="showcase__bullet-mark" aria-hidden="true"></span>
          누가 어떤 락을 걸어두었는지 다음 에이전트가 즉시 인지합니다.
        </li>
      </ul>
    </div>

    <article class="showcase__panel" aria-label="Vooster 작업실 미리보기">
      <header class="showcase__panel-head">
        <div>
          <p class="showcase__panel-eyebrow">오늘의 작업실</p>
          <p class="showcase__panel-title">vooster · team / main</p>
        </div>
        <span class="pill">
          <span class="pill__dot" aria-hidden="true"></span>
          4명 동시 작업
        </span>
      </header>

      <div class="showcase__panel-body">
        {rows.map((row) => {
          const s = statusMap[row.status as keyof typeof statusMap];
          return (
            <div class="showcase__row">
              <div class="showcase__row-left">
                <span class="showcase__row-code mono-num">{row.code}</span>
                <span class="showcase__row-title">{row.title}</span>
              </div>
              <div class="showcase__row-right">
                <span class="showcase__row-who">{row.who}</span>
                <span class="showcase__row-status" style={`--tone:${s.tone}`}>
                  <span class="showcase__row-dot" aria-hidden="true"></span>
                  {row.label}
                </span>
              </div>
            </div>
          );
        })}
      </div>

      <footer class="showcase__panel-foot">
        <span class="showcase__panel-foot-meta mono-num">
          last gate: <span style="color: var(--color-success)">PASS</span> · 11:42
        </span>
        <span class="code-chip">pnpm -r test → 475 passed</span>
      </footer>
    </article>
  </div>
</section>

<style>
  .showcase {
    padding: var(--space-7xl) 0;
    background: var(--color-canvas);
    border-bottom: var(--hairline);
    position: relative;
    overflow: hidden;
  }

  .showcase::before {
    content: "";
    position: absolute;
    inset: 20% -10% auto auto;
    width: 460px;
    height: 460px;
    background: radial-gradient(
      circle at center,
      rgba(45, 212, 191, 0.08) 0%,
      rgba(45, 212, 191, 0) 60%
    );
    filter: blur(20px);
    pointer-events: none;
  }

  .showcase__layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-6xl);
    align-items: center;
  }

  .showcase__copy .section-copy {
    margin-bottom: var(--space-2xl);
  }

  .showcase__bullets {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-md);
  }

  .showcase__bullets li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    color: var(--color-ink);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .showcase__bullet-mark {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    margin-top: 5px;
    border: 1px solid var(--color-primary-deep);
    border-radius: var(--radius-xs);
    position: relative;
  }

  .showcase__bullet-mark::after {
    content: "";
    position: absolute;
    inset: 3px;
    background: var(--color-primary);
    border-radius: 1px;
  }

  .showcase__panel {
    border: var(--hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas-soft);
    box-shadow:
      0 0 0 1px rgba(45, 212, 191, 0.06),
      0 24px 60px -32px rgba(45, 212, 191, 0.18);
    overflow: hidden;
  }

  .showcase__panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-lg) var(--space-xl);
    border-bottom: var(--hairline);
    background: var(--color-canvas);
  }

  .showcase__panel-eyebrow {
    margin: 0;
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .showcase__panel-title {
    margin: 4px 0 0;
    color: var(--color-ink-strong);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
  }

  .showcase__panel-body {
    display: grid;
  }

  .showcase__row {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-md);
    align-items: center;
    padding: var(--space-lg) var(--space-xl);
    border-top: var(--hairline);
  }

  .showcase__row:first-child {
    border-top: none;
  }

  .showcase__row-left {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-width: 0;
  }

  .showcase__row-code {
    color: var(--color-primary-soft);
    font-size: 13px;
    font-weight: 600;
  }

  .showcase__row-title {
    color: var(--color-ink);
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .showcase__row-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-md);
    min-width: 0;
  }

  .showcase__row-who {
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .showcase__row-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid color-mix(in oklab, var(--tone) 40%, transparent);
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--tone) 12%, transparent);
    color: var(--tone);
    font-size: 11.5px;
    font-weight: 500;
    white-space: nowrap;
  }

  .showcase__row-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tone);
  }

  .showcase__panel-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-xl);
    border-top: var(--hairline);
    background: var(--color-canvas);
  }

  .showcase__panel-foot-meta {
    color: var(--color-mute);
    font-size: 12px;
  }

  @media (max-width: 960px) {
    .showcase__layout {
      grid-template-columns: 1fr;
      gap: var(--space-5xl);
    }
  }

  @media (max-width: 560px) {
    .showcase__row {
      grid-template-columns: 1fr;
      align-items: flex-start;
    }

    .showcase__row-right {
      justify-content: flex-start;
    }

    .showcase__row-title {
      white-space: normal;
    }
  }
</style>
